{
  "runtimeVersion": 1,
  "metadata": {
    "id": "agent-workflows.sandcastle-templates",
    "label": "Sandcastle template equivalents",
    "description": "Pi-native deterministic runtime pack ported from the bundled Sandcastle template concepts.",
    "inspiredBy": [
      "sandcastle@0.12.0 templates/blank",
      "sandcastle@0.12.0 templates/simple-loop",
      "sandcastle@0.12.0 templates/sequential-reviewer",
      "sandcastle@0.12.0 templates/parallel-planner",
      "sandcastle@0.12.0 templates/parallel-planner-with-review"
    ]
  },
  "defaults": {
    "agentProvider": "claude-code",
    "sandboxProvider": "docker",
    "model": "Agent Default",
    "maxWorkers": 5,
    "imagePolicy": "repo-default",
    "branchPolicy": "branch-per-run",
    "completionPolicy": "promise-complete",
    "workSource": "github-issues",
    "maxIterations": 10
  },
  "providers": {
    "agentProviders": {
      "claude-code": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      },
      "pi": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      },
      "codex": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      },
      "cursor": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      },
      "opencode": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      },
      "copilot": {
        "adapter": "sandcastle",
        "defaultModel": "Agent Default",
        "capabilities": [
          "streaming",
          "tools"
        ]
      }
    },
    "sandboxProviders": {
      "docker": {
        "adapter": "sandcastle",
        "imagePolicy": "repo-default"
      },
      "podman": {
        "adapter": "sandcastle",
        "imagePolicy": "repo-default"
      },
      "vercel": {
        "adapter": "sandcastle"
      },
      "no-sandbox": {
        "adapter": "sandcastle"
      }
    }
  },
  "roles": {
    "planner": {
      "role": "planner",
      "kind": "planWork",
      "provider": "default",
      "model": "default",
      "sandbox": "default",
      "systemPrompt": "You are the Agent Workflows planner role. Analyze dependencies, select safe Work, and produce deterministic plans."
    },
    "worker": {
      "role": "worker",
      "provider": "default",
      "model": "default",
      "sandbox": "default",
      "systemPrompt": "You are the Agent Workflows worker role. Pick one open Work Item, complete it, validate it, and report results."
    },
    "implementer": {
      "role": "implementer",
      "provider": "default",
      "model": "default",
      "sandbox": "default",
      "systemPrompt": "You are the Agent Workflows implementer role. Implement the selected Work Item on an isolated branch and validate your work."
    },
    "reviewer": {
      "role": "reviewer",
      "provider": "default",
      "model": "default",
      "sandbox": "default",
      "systemPrompt": "You are the Agent Workflows reviewer role. Review branch diffs for correctness, regressions, and missing tests.",
      "kind": "review"
    },
    "merger": {
      "role": "merger",
      "provider": "default",
      "model": "default",
      "sandbox": "default",
      "systemPrompt": "You are the Agent Workflows merger role. Merge accepted branches, resolve conflicts conservatively, and summarize the result.",
      "kind": "merge"
    }
  },
  "prompts": {
    "blank": {
      "format": "markdown",
      "template": "$INPUT"
    },
    "simple-loop": {
      "format": "markdown",
      "template": "Pick the next open Work Item from the configured Work Source, implement it, validate the result, and close or clearly report the outcome.\n\nUser input:\n$INPUT"
    },
    "plan-work": {
      "format": "markdown",
      "template": "Inspect the configured Work Source and repository state. Produce a dependency-aware implementation plan with independently executable Work Items.\n\nUser input:\n$INPUT"
    },
    "implement-work": {
      "format": "markdown",
      "template": "Implement the selected Work Item on the assigned branch. Keep changes focused, run relevant tests, and end with a concise result summary.\n\nWork Item:\n$INPUT"
    },
    "review-work": {
      "format": "markdown",
      "template": "Review the completed branch or worktree for correctness, regressions, test quality, and merge blockers. Return actionable findings and an accept/reject recommendation.\n\nReview target:\n$INPUT"
    },
    "merge-work": {
      "format": "markdown",
      "template": "Merge accepted completed branches into the target branch. Resolve conflicts only when safe, run validation, and summarize merged commits.\n\nMerge context:\n$INPUT"
    },
    "archive-terminal-work": {
      "format": "markdown",
      "template": "Archive or summarize terminal-state Work Items without reopening completed implementation work.\n\nItems:\n$INPUT"
    }
  },
  "policies": {
    "branch": {
      "merge-to-head": {
        "type": "merge-to-head"
      },
      "branch-per-run": {
        "type": "branch",
        "pattern": "sandcastle/{{ pipeline.id }}/{{ run.id }}"
      }
    },
    "image": {
      "repo-default": {
        "providerFrom": "defaults.sandboxProvider",
        "namePattern": "sandcastle:<repo-dir-name>",
        "build": "if-missing-or-stale"
      }
    },
    "completion": {
      "promise-complete": {
        "promise": "COMPLETE"
      }
    }
  },
  "adapters": {
    "sandcastle": {
      "kind": "sandcastle",
      "module": "@ai-hero/sandcastle",
      "capabilities": [
        "runRole",
        "buildImage",
        "worktree"
      ]
    }
  },
  "pipelines": {
    "blank": {
      "description": "Run a single worker with caller-provided input.",
      "defaults": {
        "branchPolicy": "merge-to-head"
      },
      "kind": "composite",
      "nodes": {
        "workspace": {
          "kind": "git.worktree",
          "nodes": {
            "run": {
              "kind": "agent.pi",
              "prompt": "blank",
              "role": "worker",
              "capabilities": [
                "runRole",
                "agent.pi"
              ]
            }
          },
          "capabilities": [
            "worktree",
            "git.worktree"
          ]
        }
      }
    },
    "simple-loop": {
      "description": "Worker picks and closes one open Work Item at a time.",
      "defaults": {
        "branchPolicy": "merge-to-head"
      },
      "kind": "composite",
      "nodes": {
        "workspace": {
          "kind": "git.worktree",
          "nodes": {
            "run": {
              "kind": "agent.pi",
              "prompt": "simple-loop",
              "role": "worker",
              "capabilities": [
                "runRole",
                "agent.pi"
              ]
            }
          },
          "capabilities": [
            "worktree",
            "git.worktree"
          ]
        }
      }
    },
    "sequential-reviewer": {
      "description": "Implement one Work Item, then review the resulting branch.",
      "defaults": {
        "branchPolicy": "branch-per-run"
      },
      "kind": "composite",
      "nodes": {
        "workspace": {
          "kind": "git.worktree",
          "nodes": {
            "implement": {
              "kind": "agent.pi",
              "prompt": "implement-work",
              "role": "implementer",
              "capabilities": [
                "runRole",
                "agent.pi"
              ]
            },
            "review": {
              "kind": "agent.pi",
              "prompt": "review-work",
              "role": "reviewer",
              "needs": [
                "implement"
              ],
              "capabilities": [
                "runRole",
                "agent.pi"
              ]
            }
          },
          "capabilities": [
            "worktree",
            "git.worktree"
          ]
        }
      }
    },
    "parallel-planner": {
      "description": "Plan unblocked work, fan out implementation, then merge accepted branches.",
      "defaults": {
        "branchPolicy": "branch-per-run"
      },
      "kind": "composite",
      "nodes": {
        "implement": {
          "kind": "loop",
          "mode": "parallel",
          "each": "$.executionContexts",
          "node": {
            "kind": "git.worktree",
            "nodes": {
              "implement": {
                "kind": "agent.pi",
                "prompt": "implement-work",
                "role": "implementer",
                "capabilities": [
                  "runRole",
                  "agent.pi"
                ]
              }
            },
            "capabilities": [
              "worktree",
              "git.worktree"
            ]
          },
          "capabilities": [
            "loop"
          ]
        },
        "merge": {
          "kind": "git.merge",
          "needs": [
            "implement"
          ],
          "strategy": "accepted-only",
          "overrides": {
            "maxIterations": 1
          },
          "capabilities": [
            "merge",
            "git.merge"
          ]
        }
      }
    },
    "parallel-planner-with-review": {
      "description": "Plan unblocked work, fan out implementation, review completed branches, then merge accepted branches.",
      "defaults": {
        "branchPolicy": "branch-per-run"
      },
      "kind": "composite",
      "nodes": {
        "implement": {
          "kind": "loop",
          "mode": "parallel",
          "each": "$.executionContexts",
          "node": {
            "kind": "git.worktree",
            "nodes": {
              "implement": {
                "kind": "agent.pi",
                "prompt": "implement-work",
                "role": "implementer",
                "capabilities": [
                  "runRole",
                  "agent.pi"
                ]
              },
              "review": {
                "kind": "agent.pi",
                "prompt": "review-work",
                "role": "reviewer",
                "needs": [
                  "implement"
                ],
                "capabilities": [
                  "runRole",
                  "agent.pi"
                ]
              }
            },
            "capabilities": [
              "worktree",
              "git.worktree"
            ]
          },
          "capabilities": [
            "loop"
          ]
        },
        "merge": {
          "kind": "git.merge",
          "needs": [
            "implement"
          ],
          "strategy": "accepted-only",
          "overrides": {
            "maxIterations": 1
          },
          "inputs": [
            "implement"
          ],
          "capabilities": [
            "merge",
            "git.merge"
          ]
        }
      }
    },
    "archive": {
      "description": "Archive or summarize terminal-state Work.",
      "defaults": {
        "branchPolicy": "merge-to-head"
      },
      "kind": "composite",
      "nodes": {
        "workspace": {
          "kind": "git.worktree",
          "nodes": {
            "archive": {
              "kind": "agent.pi",
              "prompt": "archive-terminal-work",
              "role": "reviewer",
              "capabilities": [
                "runRole",
                "agent.pi"
              ]
            }
          },
          "capabilities": [
            "worktree",
            "git.worktree"
          ]
        }
      }
    }
  },
  "workSources": {
    "github-issues": {
      "kind": "github-issues",
      "listCommand": "gh issue list --state open",
      "inspectCommand": "gh issue view {{ id }}",
      "closeCommand": "gh issue close {{ id }}"
    },
    "beads": {
      "kind": "beads",
      "listCommand": "bd list --status open",
      "inspectCommand": "bd show {{ id }}",
      "closeCommand": "bd close {{ id }}"
    },
    "custom": {
      "kind": "custom"
    },
    "doc-vader": {
      "kind": "doc-vader",
      "listCommand": "dv work list",
      "inspectCommand": "dv work show {{ id }}",
      "validateCommand": "dv work validate {{ id }}",
      "closeCommand": "dv work close {{ id }}"
    }
  }
}
