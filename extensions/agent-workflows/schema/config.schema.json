{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calan.co/pi-extensions/schemas/agent-workflows/config.schema.json",
  "title": "Agent Workflows Config",
  "description": "Repo-local Agent Workflows configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtimeVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Execution Runtime config version."
    },
    "defaultSandbox": {
      "$ref": "#/$defs/sandbox",
      "description": "Default sandbox provider for roles and pipelines."
    },
    "defaultModel": {
      "type": "string",
      "minLength": 1,
      "description": "Default model reference used when a role or pipeline does not override it. Use 'Agent Default' to defer to the selected agent provider."
    },
    "defaultPipeline": {
      "type": "string",
      "minLength": 1
    },
    "defaultAgent": {
      "type": "string",
      "enum": ["claude-code", "pi", "codex", "cursor", "opencode", "copilot"]
    },
    "maxWorkers": {
      "type": "integer",
      "minimum": 1,
      "default": 5
    },
    "maxIterations": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "workSource": {
      "type": "string",
      "enum": ["github-issues", "custom", "beads", "doc-vader"]
    },
    "workSourceSetupCommand": {
      "type": "string",
      "minLength": 1
    },
    "imageNamePattern": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "description": "Reusable execution roles consumed by runtime pipelines and Work commands.",
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "prompts": {
      "type": "object",
      "description": "Reusable task prompts referenced by graph pipeline nodes.",
      "additionalProperties": { "$ref": "#/$defs/prompt" }
    },
    "policies": {
      "type": "object",
      "description": "Named reusable runtime policies.",
      "additionalProperties": { "type": "object", "additionalProperties": true }
    },
    "pipelines": {
      "type": "object",
      "description": "Deterministic runtime workflows composed from configured roles.",
      "additionalProperties": { "$ref": "#/$defs/pipeline" }
    }
  },
  "required": [] ,
  "$defs": {
    "sandbox": {
      "type": "string",
      "enum": ["docker", "podman", "vercel", "no-sandbox"]
    },
    "provider": {
      "type": "string",
      "enum": ["claude-code", "claude", "pi", "codex", "cursor", "opencode", "copilot"]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["markdown"] },
        "template": { "type": "string" }
      },
      "required": ["template"]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["planWork", "runRole", "review", "merge"] },
        "model": { "type": "string", "minLength": 1 },
        "sandbox": { "$ref": "#/$defs/sandbox" },
        "provider": { "$ref": "#/$defs/provider" },
        "systemPrompt": { "type": "string" },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "branch": { "type": "string" },
        "copyToWorktree": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "branchStrategy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["branch", "merge-to-head"] },
        "branch": { "type": "string" },
        "baseBranch": { "type": "string" }
      }
    },
    "concreteNode": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "anyOf": [
            { "enum": ["composite", "loop", "agent.pi", "git.worktree", "git.merge", "docker.container", "podman.container"] },
            { "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_-]*$" }
          ]
        },
        "needs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "inputs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "For git.merge, explicit mergeable input needs when additional needs are ordering gates."
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Unordered semantic capability metadata used by adapters and hooks."
        },
        "role": { "type": "string" },
        "prompt": { "type": "string" },
        "promptOverride": { "type": "string" },
        "each": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["sequential", "parallel"] },
        "max": { "type": "integer", "minimum": 1 },
        "node": { "$ref": "#/$defs/concreteNode" },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/concreteNode" }
        },
        "image": { "$ref": "#/$defs/containerImage" },
        "strategy": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "with": { "type": "object", "additionalProperties": true },
        "overrides": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "agent.pi" } }, "required": ["kind"] },
          "then": { "required": ["role", "prompt"] }
        },
        {
          "if": { "properties": { "kind": { "const": "loop" } }, "required": ["kind"] },
          "then": {
            "required": ["each"],
            "oneOf": [
              { "required": ["node"], "not": { "required": ["nodes"] } },
              { "required": ["nodes"], "not": { "required": ["node"] } }
            ]
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["composite", "git.worktree"] } }, "required": ["kind"] },
          "then": { "required": ["nodes"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["docker.container", "podman.container"] } }, "required": ["kind"] },
          "then": { "required": ["image"] }
        }
      ]
    },
    "containerImage": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dockerfile": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 }
      }
    },
    "pipelineStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "anyOf": [
            { "enum": ["runRole", "selectWork", "fanOut", "fanIn", "review", "merge", "postProcess", "gate"] },
            { "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9_-]*$" }
          ]
        },
        "role": { "type": "string" },
        "description": { "type": "string" },
        "prompt": { "type": "string" },
        "promptOverride": { "type": "string" },
        "with": { "type": "object", "additionalProperties": true },
        "sandbox": { "$ref": "#/$defs/sandbox" },
        "model": { "type": "string", "minLength": 1 },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "copyToWorktree": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["role", "prompt"]
    },
    "pipelineNode": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "needs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "role": { "type": "string" },
        "prompt": { "type": "string" },
        "promptOverride": { "type": "string" },
        "with": { "type": "object", "additionalProperties": true },
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pipelineNode" }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "const": "composite" },
        "description": { "type": "string" },
        "needs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "branchStrategy": { "$ref": "#/$defs/branchStrategy" },
        "sandbox": { "$ref": "#/$defs/sandbox" },
        "model": { "type": "string", "minLength": 1 },
        "copyToWorktree": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "description": "Map-form concrete nodes. Node ids are the map keys.",
          "additionalProperties": { "$ref": "#/$defs/concreteNode" }
        }
      },
      "required": ["kind", "nodes"]
    }
  }
}
