{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calan.co/pi-extensions/schemas/pi-sandcastle/execution-runtime.schema.json",
  "title": "Pi-Sandcastle Execution Runtime",
  "description": "Deterministic Pi-native runtime contract for Sandcastle-backed agent execution packs.",
  "type": "object",
  "required": ["runtimeVersion", "defaults", "roles", "prompts", "pipelines"],
  "additionalProperties": false,
  "properties": {
    "runtimeVersion": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "providers": {
      "$ref": "#/$defs/providers"
    },
    "issueTrackers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/issueTracker"
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "prompts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/prompt"
      }
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "stepModules": {
      "type": "object",
      "description": "Reusable pack-internal step templates that compile to pipeline steps.",
      "additionalProperties": {
        "$ref": "#/$defs/stepModule"
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/adapter"
      }
    },
    "pipelines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pipeline"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "referenceOrDefault": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inspiredBy": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "compatibility": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentProvider": { "$ref": "#/$defs/referenceOrDefault" },
        "sandboxProvider": { "$ref": "#/$defs/referenceOrDefault" },
        "model": { "type": "string", "minLength": 1 },
        "issueTracker": { "$ref": "#/$defs/referenceOrDefault" },
        "imagePolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "branchPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "completionPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "retryPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "concurrencyPolicy": { "$ref": "#/$defs/referenceOrDefault" }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentProviders": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/provider" }
        },
        "sandboxProviders": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/provider" }
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["adapter"],
      "additionalProperties": false,
      "properties": {
        "adapter": { "$ref": "#/$defs/identifier" },
        "defaultModel": { "type": "string", "minLength": 1 },
        "imagePolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "issueTracker": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "adapter": { "$ref": "#/$defs/identifier" },
        "listCommand": { "type": "string", "minLength": 1 },
        "inspectCommand": { "type": "string", "minLength": 1 },
        "closeCommand": { "type": "string", "minLength": 1 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "provider": { "$ref": "#/$defs/referenceOrDefault" },
        "model": { "type": "string", "minLength": 1 },
        "sandbox": { "$ref": "#/$defs/referenceOrDefault" },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "systemPrompt": { "type": "string" },
        "copyToWorktree": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "branchPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "completionPolicy": { "$ref": "#/$defs/referenceOrDefault" }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["markdown", "text", "json"] },
        "template": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input" }
        }
      },
      "anyOf": [
        { "required": ["template"] },
        { "required": ["file"] }
      ]
    },
    "input": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"] },
        "required": { "type": "boolean" },
        "default": true,
        "description": { "type": "string" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/branchPolicy" }
        },
        "image": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/imagePolicy" }
        },
        "completion": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/completionPolicy" }
        },
        "retry": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/retryPolicy" }
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/concurrencyPolicy" }
        }
      }
    },
    "branchPolicy": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["branch", "merge-to-head", "none"] },
        "pattern": { "type": "string", "minLength": 1 },
        "baseBranch": { "type": "string", "minLength": 1 }
      }
    },
    "imagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerFrom": { "type": "string", "minLength": 1 },
        "namePattern": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "enum": ["never", "if-missing", "if-missing-or-stale", "always"] }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promise": { "type": "string", "minLength": 1 },
        "successPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "failurePatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "backoffMs": { "type": "integer", "minimum": 0 }
      }
    },
    "concurrencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "module": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "defaults": { "$ref": "#/$defs/pipelineDefaults" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pipelineStep" }
        }
      }
    },
    "pipelineDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/referenceOrDefault" },
        "model": { "type": "string", "minLength": 1 },
        "sandbox": { "$ref": "#/$defs/referenceOrDefault" },
        "branchPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "completionPolicy": { "$ref": "#/$defs/referenceOrDefault" },
        "imagePolicy": { "$ref": "#/$defs/referenceOrDefault" }
      }
    },
    "stepModule": {
      "allOf": [
        { "$ref": "#/$defs/pipelineStepBase" },
        { "required": ["kind"] }
      ]
    },
    "pipelineStep": {
      "allOf": [
        { "$ref": "#/$defs/pipelineStepBase" },
        { "required": ["id", "kind"] }
      ]
    },
    "pipelineStepBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "enum": ["runAgent", "selectWork", "fanOut", "fanIn", "review", "merge", "postProcess", "gate"] },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "role": { "$ref": "#/$defs/referenceOrDefault" },
        "prompt": { "$ref": "#/$defs/referenceOrDefault" },
        "issueTracker": { "$ref": "#/$defs/referenceOrDefault" },
        "limit": { "type": "integer", "minimum": 1 },
        "over": { "type": "string", "minLength": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "step": { "$ref": "#/$defs/pipelineStep" },
        "strategy": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "with": {
          "type": "object",
          "additionalProperties": true
        },
        "overrides": { "$ref": "#/$defs/pipelineDefaults" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "runAgent" } }, "required": ["kind"] },
          "then": { "required": ["role", "prompt"] }
        },
        {
          "if": { "properties": { "kind": { "const": "fanOut" } }, "required": ["kind"] },
          "then": { "required": ["over", "step"] }
        },
        {
          "if": { "properties": { "kind": { "const": "review" } }, "required": ["kind"] },
          "then": { "required": ["role", "prompt"] }
        }
      ]
    }
  }
}
