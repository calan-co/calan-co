{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calan-co/calan-co/schema/release-artifacts.schema.json",
  "title": "Calan & Co release artifact catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "owner", "versionSource", "adapter", "target", "environment", "dryRunCommand", "publishCommand", "receiptCommand", "rollbackCommand"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!legacy(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "owner": { "type": "string", "minLength": 1 },
          "versionSource": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "dryRunCommand": { "type": "string", "minLength": 1 },
          "publishCommand": { "type": "string", "minLength": 1 },
          "receiptCommand": { "type": "string", "minLength": 1 },
          "rollbackCommand": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
