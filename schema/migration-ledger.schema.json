{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calan-co/calan-co/schema/migration-ledger.schema.json",
  "title": "Calan & Co migration ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "migrations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "targetPath", "owner", "artifacts", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri" },
          "targetPath": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "state": { "enum": ["queued", "history-imported", "imported", "parity-verified", "staging-released", "cut-over", "archived", "blocked"] },
          "sourceFreezeDate": { "type": "string", "format": "date" },
          "historyImportEvidence": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "testCommand": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "adapterEvidence": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "parityEvidence": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "stagingReceipt": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "rollbackTarget": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "archiveEvidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": { "const": "history-imported" }
              },
              "required": ["state"]
            },
            "then": {
              "properties": {
                "targetPath": { "pattern": "^legacy/" }
              },
              "required": ["sourceFreezeDate", "rollbackTarget", "historyImportEvidence"]
            }
          },
          {
            "if": {
              "properties": {
                "state": { "enum": ["imported", "parity-verified", "staging-released", "cut-over", "archived"] }
              },
              "required": ["state"]
            },
            "then": {
              "required": ["sourceFreezeDate", "rollbackTarget", "testCommand", "adapterEvidence"]
            }
          },
          {
            "if": {
              "properties": {
                "state": { "enum": ["parity-verified", "staging-released", "cut-over", "archived"] }
              },
              "required": ["state"]
            },
            "then": { "required": ["parityEvidence"] }
          },
          {
            "if": {
              "properties": {
                "state": { "enum": ["staging-released", "cut-over", "archived"] }
              },
              "required": ["state"]
            },
            "then": { "required": ["stagingReceipt"] }
          },
          {
            "if": {
              "properties": {
                "state": { "const": "archived" }
              },
              "required": ["state"]
            },
            "then": { "required": ["archiveEvidence"] }
          },
          {
            "if": {
              "properties": {
                "state": { "const": "queued" }
              },
              "required": ["state"]
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["sourceFreezeDate"] },
                  { "required": ["historyImportEvidence"] },
                  { "required": ["testCommand"] }
                  { "required": ["adapterEvidence"] },
                  { "required": ["parityEvidence"] },
                  { "required": ["stagingReceipt"] },
                  { "required": ["rollbackTarget"] },
                  { "required": ["archiveEvidence"] }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
