{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calan-co/calan-co/schema/migration-inventory.schema.json",
  "title": "Calan & Co authoritative migration source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sources"],
  "properties": {
    "$schema": { "const": "../schema/migration-inventory.schema.json" },
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "defaultBranch", "defaultSha", "status", "targetPath", "exclusions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+$"
          },
          "defaultBranch": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "defaultSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "status": { "enum": ["eligible-for-import", "history-imported", "internal-source-imported", "blocked", "excluded"] },
          "targetPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "exclusions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
